Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Internal application and private-storage paths are never public.
    RewriteRule ^(?:app|bin|database|includes|storage)/ - [F,L,NC]
    RewriteRule (^|/)\. - [F,L]

    # Redirect old PHP addresses to canonical, human-readable URLs.
    RewriteCond %{THE_REQUEST} \s/+index\.php[?\s] [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+service\.php\?service=([a-z-]+) [NC]
    RewriteRule ^service\.php$ /services/%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+([a-z-]+)\.php[?\s] [NC]
    RewriteRule ^(about|services|training|work|contact|privacy|terms)\.php$ /$1 [R=301,L]

    # Send every non-file request to the PHP front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [END,QSA]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
