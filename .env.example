APP_ENV=production
APP_URL=https://www.haleefglobal.com
APP_TIMEZONE=Asia/Dubai
APP_KEY=

# Public WhatsApp contact, digits in international format (country code, no +).
# Leave empty to hide the floating button.
WHATSAPP_NUMBER=

# Agenda email sends only after the Brevo sender and cron worker are set up.
AGENDA_EMAIL_ENABLED=0
BREVO_API_KEY=
# Optional verified Brevo sender for contact enquiries; falls back to AGENDA_EMAIL_FROM.
CONTACT_EMAIL_FROM=
AGENDA_EMAIL_FROM=
AGENDA_EMAIL_FROM_NAME="Haleef Learning"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=haleef
DB_USERNAME=haleef_app
DB_PASSWORD=

PRIVATE_STORAGE_PATH=storage/private

# Verify issuer and bank details and schedule the registration worker before enabling.
BANK_TRANSFER_INVOICES_ENABLED=0
INVOICE_ISSUER_NAME=
INVOICE_ISSUER_ADDRESS=
INVOICE_ISSUER_LICENSE=
INVOICE_REPLY_TO=team@haleefglobal.com
# Optional if AGENDA_EMAIL_FROM is already a verified Haleef Learning sender.
REGISTRATION_EMAIL_FROM=
MAX_PAYMENT_EVIDENCE_MB=10
PUBLIC_STORAGE_DRIVER=local
PUBLIC_STORAGE_PATH=storage/public-resources
MAX_PUBLIC_ASSET_MB=15
BACKUP_STORAGE_PATH=storage/backups
BACKUP_RETENTION_DAYS=14

