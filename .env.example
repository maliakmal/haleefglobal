APP_ENV=production
APP_URL=https://www.haleefglobal.com
APP_TIMEZONE=Asia/Dubai
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=haleef
DB_USERNAME=haleef_app
DB_PASSWORD=

PRIVATE_STORAGE_PATH=storage/private
MAX_PAYMENT_EVIDENCE_MB=10
PUBLIC_STORAGE_DRIVER=local
PUBLIC_STORAGE_PATH=storage/public-resources
MAX_PUBLIC_ASSET_MB=15
BACKUP_STORAGE_PATH=storage/backups
BACKUP_RETENTION_DAYS=14

